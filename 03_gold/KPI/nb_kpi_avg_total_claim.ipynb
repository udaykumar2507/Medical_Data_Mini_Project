     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "SELECT \n",
    "  fc.payer_name,\n",
    "  ROUND(AVG(fc.total_claim_cost),2) as avg_cost\n",
    "  \n",
    "  from medical_catalog.gold.fact_payer_cube fc\n",
    "\n",
    "GROUP BY fc.payer_name\n",
    "ORDER BY avg_cost DESC;\n"
   ]
  }
 ],
